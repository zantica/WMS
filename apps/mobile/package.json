{
  "name": "@wms/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "web": "expo start --web --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.9",
    "@wms/shared-types": "workspace:*",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.5",
    "expo-constants": "~58.0.9",
    "expo-linking": "~58.0.9",
    "expo-router": "~58.0.10",
    "expo-status-bar": "~58.0.2",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.0.10",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
