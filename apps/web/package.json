{
  "name": "@wms/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@wms/shared-types": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vite": "5.4.21",
    "vitest": "^2.1.0"
  }
}
